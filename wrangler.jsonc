{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "magizh-api-fdb2",
  "main": "worker.js",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "magizh-db",
      "database_id": "PASTE_EXISTING_MAGIZH_DB_ID_HERE"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "magizh-products"
    }
  ]
}
