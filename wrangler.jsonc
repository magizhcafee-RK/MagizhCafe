{
  "name": "magizh-api-fdb2",
  "main": "worker.js",
  "compatibility_date": "2026-10-02",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "magizh-db",
      "database_id": "df4995ae-0e06-4c9b-9e4f-c36ea4581734"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "vars": {
    "EMAIL_FROM": "SET_THIS_TO_YOUR_VERIFIED_SENDER_EMAIL"
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "magizh-products"
    }
  ]
}
